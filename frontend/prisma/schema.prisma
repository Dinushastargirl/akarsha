datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Salon {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(255)
  subdomain String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("salons")
}

model User {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.VarChar(100)
  username     String   @db.VarChar(150)
  email        String   @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([tenantId, email], map: "uq_users_tenant_email")
  @@index([tenantId], map: "idx_users_tenant")
  @@map("users")
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.VarChar(100)
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String   @db.VarChar(20)
  email     String?  @db.VarChar(255)
  birthday  DateTime? @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([tenantId], map: "idx_customers_tenant")
  @@map("customers")
}

model Service {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.VarChar(100)
  name      String   @db.VarChar(150)
  price     Decimal  @db.Decimal(10, 2)
  duration  Int      
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([tenantId], map: "idx_services_tenant")
  @@map("services")
}

model Appointment {
  id              BigInt   @id @default(autoincrement())
  tenantId        String   @map("tenant_id") @db.VarChar(100)
  customerId      BigInt   @map("customer_id")
  staffId         BigInt   @map("staff_id")
  serviceId       BigInt   @map("service_id")
  appointmentDate DateTime @map("appointment_date") @db.Date
  startTime       DateTime @map("start_time") @db.Time
  endTime         DateTime @map("end_time") @db.Time
  status          String   @default("BOOKED") @db.VarChar(20)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([tenantId], map: "idx_appointments_tenant")
  @@map("appointments")
}
